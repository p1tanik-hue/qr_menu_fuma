# ─────────────────────────────────────────────────────────────
# FUMA LOUNGE — environment variables
# Copy to `.env` (local) and set real secrets in production.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma.
# In Docker Compose the host is the service name `db`.
DATABASE_URL="postgresql://fuma:fuma_password@localhost:5432/fuma?schema=public"

# Postgres container credentials (used by docker-compose db service).
POSTGRES_USER=fuma
POSTGRES_PASSWORD=fuma_password
POSTGRES_DB=fuma

# Session signing secret for admin JWT cookies.
# Generate a strong one: `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Public site URL (used for canonical, OpenGraph, sitemap, robots).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Human-readable restaurant name (branding fallback).
NEXT_PUBLIC_RESTAURANT_NAME="FUMA LOUNGE"

# Initial admin account created by the seeder (change before production!).
SEED_ADMIN_EMAIL="admin@fuma.local"
SEED_ADMIN_PASSWORD="ChangeMe_Str0ng!"

# Brute-force protection tuning.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Node env
NODE_ENV="development"
